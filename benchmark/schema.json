{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Korean Chinese alignment benchmark",
  "type": "object",
  "required": [
    "version",
    "language_pair",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "language_pair": {
      "const": "ko-zh-Hant"
    },
    "provenance": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "sure",
          "possible"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sure": {
            "$ref": "#/$defs/edges"
          },
          "possible": {
            "$ref": "#/$defs/edges"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
